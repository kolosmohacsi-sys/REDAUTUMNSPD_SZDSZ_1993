title: Election
on-arrival: {!

Q.transit = {}; //Defining

for (var c1 of Q.classes){
    Q.transit[c1] = {};
    for (var c2 of Q.parties){
        Q.transit[c1][c2] = {};
        for (var c3 of Q.parties){
            if (c2 == c3){
                Q.transit[c1][c2][c3] = 1;
            }else{
                Q.transit[c1][c2][c3] = Q[c1 + "_" + c3] / (100 - Q[c1 + "_" + c2]);
            }
        }
    }
}

Q.oevkgain = {}; //Defining the Array of Individual Constituency Winners
Q.reggain = {};
Q.totalpref = {};

for (var p of Q.parties) {
    Q.oevkgain[p] = 0;
    Q.reggain[p] = 0;
    Q.totalpref[p] = 0;
}

//We assume all OEVKs have 45 000 voters, so we calculate 176 * 45000

Q.eligible = 7920000

//Calculate Party Preferences in each Individual Constituency (OEVK)
for (var c1 of Q.OEVK) {
    c1.support = {};
    for (var c2 of Q.parties) {
        c1.support[c2] = 0;
        for (var c3 of Q.classes) {
            c1.support[c2] += Q[c3 + "_" + c2]/100 * c1.classes[c3]/100;
        }
        c1.support[c2] = c1.support[c2] * 45000;
    }
    c1.allvoters = 45000 - c1.support['abstain'];
}

//Aggregate Party Preferences for each Electoral Region
for (var r1 of Q.Region) {
    r1.support = {};
    r1.allvoters = 0;
    for (var r2 of Q.parties) {
        r1.support[r2] = 0;
        for (var r3 of Q.OEVK) {
            if (r3.region == r1.id) {
                r1.support[r2] += r3.support[r2];
                r1.allvoters += r3.support[r2]
            }
        }
    } 
    r1.allvoters = r1.allvoters - r1.support['abstain'];
}

//Aggregate Party Preferences for the National Level

Q.allvoters = 0;
Q.nattreshhold = {};

for (var c1 of Q.parties){
    for (c2 of Q.Region){
        if(c2){
            Q.totalpref[c1] += c2.support[c1]
        }
    }
    Q.allvoters = Q.eligible - Q.totalpref['abstain'];
}

//Calculate Independents Effect on Elections

for(var c1 of Q.OEVK){
    momentum = Math.tan(Math.PI * (Math.random()-0.5)) //We want to simulate occasional outliers for local celebrities running, we do this with creating approximate Cauchy-Distribution based random number generation of Devroye (1986)
    momentum = momentum*0.37-6 //Transform our numbers to give less outlier cases, and for the common case to be really low value
    momentum = 1 / (1 + Math.exp(momentum*-1)) //Put our random number into a Sigmoid / Logit function to make its value between 0 and 1, while taking into account the
    momentum = 0.3*momentum //We cap this momentum at about 30% so that it can be beaten if the local party is ver embedded
    for (var c2 of Q.parties){
        if (c2 === "other") continue;
        c1.support["other"] += c1.support[c2]*momentum
        c1.support[c2] -= c1.support[c2]*momentum
    }
}


//Check if a party exeecd the 4% national treshold

for (var c1 of Q.parties){
    Q.nattreshhold[c1] = Q.totalpref[c1] / Q.allvoters * 100 > 4 && c1 != 'abstain' && c1 != "other";
}

//Decide which party wins each Individual consituency

//Checking first rounds

for (var c1 of Q.OEVK) {
    if(c1.support['abstain'] < 22500){
        for (var c2 of Q.parties) {
            if (c1.support[c2] > c1.allvoters*0.5 && c2!="abstain") {
                c1.round = "first";
                c1.winner = c2;
                c1.winrate = c1.support[c2]/c1.allvoters;
                Q.oevkgain[c2] += 1;
            }
        }
    }
    if (typeof c1.winner === "undefined"){
        c1.round = "second";
    }
}

//checking second rounds

for (var c1 of Q.OEVK) {
    if (c1.round == "second") {
        c1.qualify = {};
        var qualifyCount = 0;
        for (var c2 of Q.parties) {
            if (c2 != "abstain"){
                c1.qualify[c2] = c1.support[c2] > c1.allvoters*0.15;
                if (c1.qualify[c2]) qualifyCount++;
            }else{
                c1.qualify[c2] = true;
            }
        }
        if (qualifyCount < 3) {
            for (var c2 of Q.parties) {
                if(c2 !="abstain") continue;
                var betterCount = 0;
                for (var other of Q.parties) {
                    if(other !="abstain") continue;
                    if (c1.support[other] > c1.support[c2]) betterCount++;
                }
                c1.qualify[c2] = betterCount < 3;
            }
        }
    }
}

for (var c1 of Q.OEVK) {
    if (c1.round == "second") {
        c1.support_r2 = {};
        c1.r2allvotes = 0;
        for (var c2 of Q.parties) {
            c1.support_r2[c2] = c1.qualify[c2] ? c1.support[c2] : 0;
        }
        for (var c3 of Q.parties) {
            if (c1.qualify[c3]) continue;
            for (var c4 of Q.classes) {
                var c3_votes_in_class = (Q[c4 + "_" + c3] / 100) * c1.classes[c4] / 100 * 45000;
                for (var c2 of Q.parties) {
                    if (!c1.qualify[c2]) continue;  // csak a bejutott jeloltek kapjak
                    c1.support_r2[c2] += c3_votes_in_class * Q.transit[c4][c3][c2];
                }
            }
        }
        for (var c2 of Q.parties) {
            if(c2 =="abstain") continue;
            c1.r2allvotes += c1.support_r2[c2];
        }
    }
}

for (var c1 of Q.OEVK) {
    if (c1.round == "second") {
        var maxV = -Infinity, maxP = null;
        for (var c2 of Q.parties) {
            if (c1.qualify[c2] && c1.support_r2[c2] > maxV && c2!='abstain') {
                maxV = c1.support_r2[c2];
                maxP = c2;
            }
        }
        c1.winner = maxP;
        c1.winrate = maxV / c1.r2allvotes
        Q.oevkgain[maxP] += 1;
    }
}

//Check if the party eligible compensatory votes in OEVKs

for (var c1 of Q.OEVK) {
    c1.comp = {};
    for (var c2 of Q.parties) {
        c1.comp[c2] = (c1.winner == c2) ? 0 : c1.support[c2];
        c1.comp[c2] = (Q.nattreshhold[c2]) ? c1.comp[c2] : 0; 
    }
}

//Calculate the Hagenbach-Bischoff qoutas for each region

for (var d1 of Q.Region) {
    d1.total = 0;
    for (var d2 of Q.parties) {
        d1.total += d1.support[d2];
    }
    d1.cutoff = d1.allvoters / (d1.mandates + 1);
}

//Calculate the Regional Mandates

for (var f1 of Q.Region) {
    f1.gain = {};
    f1.comp = {};
    f1.kioszt = 0;
    f1.maradek = {};
    for (var f2 of Q.parties) {
        f1.gain[f2] = (Q.nattreshhold[f2]) ? Math.floor(f1.support[f2] / f1.cutoff) : 0;
        Q.reggain[f2] += f1.gain[f2];
        f1.kioszt += f1.gain[f2];
        f1.comp[f2] = (Q.nattreshhold[f2]) ? f1.support[f2] - f1.gain[f2] * f1.cutoff : 0;
    }
    if (f1.mandates - f1.kioszt > 0){
        for (var f3 of Q.parties){
            var more = 0
            for (var f4 of Q.parties){
                if (f1.comp[f4] > f1.comp[f3]) more++;
            }
            if (more < (f1.mandates - f1.kioszt) && f1.comp[f3] >= 2*f1.cutoff/3){
                f1.gain[f3] += 1;
                Q.reggain[f3] += 1;
                f1.maradek[f3] = true
            }
        }
    }
    for (var f5 of Q.parties){
        f1.comp[f5] = f1.maradek[f5]? 0 : f1.comp[f5];
    }
}

//Calculate compensatory votes for each party (note: non-eligible parties technically participate in these votings, but with 0 votes)

Q.comp = {};
for (var c1 of Q.parties) {
    Q.comp[c1] = 0;
    for (var c2 of Q.OEVK) {
        Q.comp[c1] += c2.comp[c1];
    }
    for (var c3 of Q.Region) {
        Q.comp[c1] += c3.comp[c1];
    }
}

//Calculate how many mandates should be given out through National Compensatory mandates

Q.Natmand = 210;
for (var c1 of Q.Region) {
    for (var c2 of Q.parties) {
        Q.Natmand -= c1.gain[c2];
    }
}

//Iterate a D'hont formula to distriubte the mandates

Q.natgain = {};
for (var p1 of Q.parties) Q.natgain[p1] = 0;

for (var i = 0; i < Q.Natmand; i++) {
    var bestParty = null;
    var bestQuotient = -1;
    for (var p2 of Q.parties) {
        var quotient = Q.comp[p2] / (Q.natgain[p2] + 1);
        if (quotient > bestQuotient) {
            bestQuotient = quotient;
            bestParty = p2;
        }
    }
    Q.natgain[bestParty] += 1;
}

//Saves seats to return the exact formula for the parlaiment

Q.seats = {};
for (var p of Q.parties) {
    Q.seats[p] = Q.oevkgain[p] + Q.reggain[p] + Q.natgain[p];
}

//Round parlament proportions for aesthetic reasons

for (var p of Q.parties) {
    Q[p + "_r"] = Math.round((Q.seats[p] / 3.86)*100)/100;
}
!}
