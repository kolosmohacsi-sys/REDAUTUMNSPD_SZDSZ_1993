title: Election
on-arrival: {!
Q.oevkgain = {};
Q.reggain = {};
for (var p of Q.parties) {
    Q.oevkgain[p] = 0;
    Q.reggain[p] = 0;
}

for (var c1 of Q.OEVK) {
    c1.support = {};
    for (var c2 of Q.parties) {
        c1.support[c2] = 0;
        for (var c3 of Q.classes) {
            c1.support[c2] += Q[c3 + "_" + c2] * c1.classes[c3];
        }
    }
}

for (var r1 of Q.Region) {
    r1.support = {};
    for (var r2 of Q.parties) {
        r1.support[r2] = 0;
        for (var r3 of Q.OEVK) {
            if (r3.region == r1.id) {
                r1.support[r2] += r3.support[r2];
            }
        }
    }
}

for (var c1 of Q.OEVK) {
    var maxValue = -Infinity;
    var maxParty = null;
    for (var c2 of Q.parties) {
        if (c1.support[c2] > maxValue) {
            maxValue = c1.support[c2];
            maxParty = c2;
        }
    }
    c1.winner = maxParty;
    c1.winner_value = maxValue;
    Q.oevkgain[maxParty] += 1;
}

for (var c1 of Q.OEVK) {
    c1.comp = {};
    for (var c2 of Q.parties) {
        c1.comp[c2] = (c1.winner == c2) ? 0 : c1.support[c2];
    }
}

for (var d1 of Q.Region) {
    d1.total = 0;
    for (var d2 of Q.parties) {
        d1.total += d1.support[d2];
    }
    d1.cutoff = d1.total / (d1.mandates + 1);
}

for (var f1 of Q.Region) {
    f1.gain = {};
    f1.comp = {};
    for (var f2 of Q.parties) {
        f1.gain[f2] = Math.floor(f1.support[f2] / f1.cutoff);
        Q.reggain[f2] += f1.gain[f2];
        f1.comp[f2] = f1.support[f2] - f1.gain[f2] * f1.cutoff;
    }
}

Q.comp = {};
for (var c1 of Q.parties) {
    Q.comp[c1] = 0;
    for (var c2 of Q.OEVK) {
        Q.comp[c1] += c2.comp[c1];
    }
    for (var c3 of Q.Region) {
        Q.comp[c1] += c3.comp[c1];
    }
}

Q.Natmand = 210;
for (var c1 of Q.Region) {
    for (var c2 of Q.parties) {
        Q.Natmand -= c1.gain[c2];
    }
}

Q.natgain = {};
for (var p1 of Q.parties) Q.natgain[p1] = 0;

for (var i = 0; i < Q.Natmand; i++) {
    var bestParty = null;
    var bestQuotient = -1;
    for (var p2 of Q.parties) {
        var quotient = Q.comp[p2] / (Q.natgain[p2] + 1);
        if (quotient > bestQuotient) {
            bestQuotient = quotient;
            bestParty = p2;
        }
    }
    Q.natgain[bestParty] += 1;
}

Q.seats = {};
for (var p of Q.parties) {
    Q.seats[p] = Q.oevkgain[p] + Q.reggain[p] + Q.natgain[p];
}
for (var p of Q.parties) {
    Q[p + "_r"] = Q.seats[p] / 3.86;
}
!}
go-to: jumpScene