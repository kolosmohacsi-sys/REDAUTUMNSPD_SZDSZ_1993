title: Election
on-arrival: {!

Q.transit = {}; // Defining party transitional Matrix

Q.ideology = {
    'kpd': -6, 'spd': -2, 'ddp': 1, 'z': 4, 'dnvp': 5, 'dvp': 6, 'other': 0
};

Q.gamma = 0.25; // Ideológiai büntetés mértéke (minél nagyobb, annál kevésbé szavaznak át távoli pártra)

Q.transit = {}; 

for (var c1 of Q.classes) {
    Q.transit[c1] = {};
    for (var c2 of Q.parties) {
        Q.transit[c1][c2] = {};
        
        var totalRawWeight = 0;
        var rawWeights = {};

        for (var c3 of Q.parties) {
            if (c2 === c3) {
                rawWeights[c3] = 1.0;
            } else if (c3 === 'abstain') {
                // A távolmaradásra egy fix alapbeállítást hagyunk
                rawWeights[c3] = (Q[c1 + "_abstain"] || 10) / 100;
            } else {
                // Demográfiai átszavazási alapérték
                var demoWeight = Q[c1 + "_" + c3] / (100 - Q[c1 + "_" + c2]);

                // Ideológiai távolság alapján történő súlyozás
                var dist = Math.abs((Q.ideology[c2] || 0) - (Q.ideology[c3] || 0));
                var ideoWeight = Math.exp(-Q.gamma * dist);

                // A végső súly a demográfiai és ideológiai tényező szorzata
                rawWeights[c3] = demoWeight * ideoWeight;
            }
            totalRawWeight += rawWeights[c3];
        }

        // Normalizálás: a sor összege 1.0 (100%) legyen
        for (var c3 of Q.parties) {
            Q.transit[c1][c2][c3] = rawWeights[c3] / totalRawWeight;
        }
    }
}

Q.oevkgain = {}; 
Q.reggain = {}; 
Q.totalpref = {}; 

for (var p of Q.parties) { 
    Q.oevkgain[p] = 0;
    Q.reggain[p] = 0;
    Q.totalpref[p] = 0;
}

Q.eligible = 7920000;

// Calculate Party Preferences in each oevk
for (var c1 of Q.oevk) {
    c1.support = {};
    for (var c2 of Q.parties) {
        c1.support[c2] = 0;
        for (var c3 of Q.classes) {
            c1.support[c2] += Q[c3 + "_" + c2]/100 * c1.classes[c3]/100;
        }
        c1.support[c2] = c1.support[c2] * 45000;
    }
    c1.allvoters = 45000 - c1.support['abstain'];
}

// Aggregate Party Preferences for each Electoral Region
for (var r1 of Q.Region) {
    r1.support = {};
    r1.allvoters = 0;
    for (var r2 of Q.parties) {
        r1.support[r2] = 0;
        for (var r3 of Q.oevk) {
            if (r3.region == r1.id) {
                r1.support[r2] += r3.support[r2];
                r1.allvoters += r3.support[r2];
            }
        }
    } 
    r1.allvoters = r1.allvoters - r1.support['abstain'];
}

// Aggregate Party Preferences for National Level
Q.allvoters = 0;
Q.nattreshhold = {};

for (var c1 of Q.parties){
    for (var c2 of Q.Region){ // Fixed missing var
        if(c2){
            Q.totalpref[c1] += c2.support[c1];
        }
    }
}
Q.allvoters = Q.eligible - Q.totalpref['abstain'];

// Calculate Independents Effect
for(var c1 of Q.oevk){
    var momentum = Math.tan(Math.PI * (Math.random()-0.5));
    momentum = momentum*0.37-6;
    momentum = 1 / (1 + Math.exp(momentum*-1));
    momentum = 0.3*momentum;
    for (var c2 of Q.parties){
        if (c2 === "other") continue;
        c1.support["other"] += c1.support[c2]*momentum;
        c1.support[c2] -= c1.support[c2]*momentum;
    }
}

// Check 4% National Threshold
for (var c1 of Q.parties){
    Q.nattreshhold[c1] = (Q.totalpref[c1] / Q.allvoters * 100 > 4) && c1 !== 'abstain' && c1 !== "other";
}

// oevk First Round Checks
for (var c1 of Q.oevk) {
    if(c1.support['abstain'] < 22500){
        for (var c2 of Q.parties) {
            if (c1.support[c2] > c1.allvoters*0.5 && c2 !== "abstain") {
                c1.round = "first";
                c1.winner = c2;
                c1.winrate = c1.support[c2]/c1.allvoters;
                Q.oevkgain[c2] += 1;
            }
        }
    }
    if (typeof c1.winner === "undefined"){
        c1.round = "second";
    }
}

// oevk Second Round Qualifications
for (var c1 of Q.oevk) {
    if (c1.round == "second") {
        c1.qualify = {};
        var qualifyCount = 0;
        for (var c2 of Q.parties) {
            if (c2 !== "abstain"){
                c1.qualify[c2] = c1.support[c2] > c1.allvoters*0.15;
                if (c1.qualify[c2]) qualifyCount++;
            } else {
                c1.qualify[c2] = true;
            }
        }
        if (qualifyCount < 3) {
            for (var c2 of Q.parties) {
                if(c2 === "abstain") continue;
                var betterCount = 0;
                for (var other of Q.parties) {
                    if(other === "abstain") continue;
                    if (c1.support[other] > c1.support[c2]) betterCount++;
                }
                c1.qualify[c2] = betterCount < 3;
            }
        }
    }
}

// Reallocating Voters (Multi-Hop Markov Chain)
for (var c1 of Q.oevk) {
    if (c1.round === "second") {
        var qualifiedList = Q.parties.filter(p => c1.qualify[p]);
        
        var P = {};
        for (var c4 of Q.classes) {
            P[c4] = {};
            for (var c3 of Q.parties) {
                P[c4][c3] = {};
                if (c1.qualify[c3] || c3 === 'abstain') {
                    for (var target of Q.parties) {
                        P[c4][c3][target] = (c3 === target) ? 1.0 : 0.0;
                    }
                } else {
                    var totalRowWeight = 0;
                    for (var target of Q.parties) {
                        totalRowWeight += Q.transit[c4][c3][target] || 0;
                    }

                    for (var target of Q.parties) {
                        if (totalRowWeight > 0) {
                            P[c4][c3][target] = (Q.transit[c4][c3][target] || 0) / totalRowWeight;
                        } else {
                            P[c4][c3][target] = (target === 'abstain') ? 1.0 : 0.0;
                        }
                    }
                }
            }
        }

        var currentSupport = {};
        for (var c4 of Q.classes) {
            currentSupport[c4] = {};
            for (var c3 of Q.parties) {
                currentSupport[c4][c3] = (Q[c4 + "_" + c3] / 100) * (c1.classes[c4] / 100) * 45000;
            }
        }

        var maxHops = 10;
        for (var hop = 0; hop < maxHops; hop++) {
            var nextSupport = {};
            var unallocatedVotesLeft = 0;

            for (var c4 of Q.classes) {
                nextSupport[c4] = {};
                for (var p of Q.parties) nextSupport[c4][p] = 0;

                for (var fromP of Q.parties) {
                    var votesToMove = currentSupport[c4][fromP];
                    if (!c1.qualify[fromP] && fromP !== 'abstain') {
                        unallocatedVotesLeft += votesToMove;
                    }
                    for (var toP of Q.parties) {
                        nextSupport[c4][toP] += votesToMove * P[c4][fromP][toP];
                    }
                }
            }

            currentSupport = nextSupport;
            if (unallocatedVotesLeft < 0.1) break;
        }

        c1.support_r2 = {};
        c1.r2allvotes = 0;
        for (var p of Q.parties) c1.support_r2[p] = 0;

        for (var c4 of Q.classes) {
            for (var p of Q.parties) {
                c1.support_r2[p] += currentSupport[c4][p];
            }
        }

        for (var p of Q.parties) {
            if (p !== 'abstain') {
                c1.r2allvotes += c1.support_r2[p];
            }
        }
    }
}

// Find Round 2 Winners
for (var c1 of Q.oevk) {
    if (c1.round === "second") {
        var maxV = -Infinity, maxP = null;
        for (var c2 of Q.parties) {
            if (c1.qualify[c2] && c1.support_r2[c2] > maxV && c2 !== 'abstain') {
                maxV = c1.support_r2[c2];
                maxP = c2;
            }
        }
        c1.winner = maxP;
        c1.winrate = maxV / c1.r2allvotes;
        Q.oevkgain[maxP] += 1;
    }
}

// oevk Compensatory Votes Calculation
for (var c1 of Q.oevk) {
    c1.comp = {};
    for (var c2 of Q.parties) {
        // Fixed: Use support_r2 if district went to second round
        var finalVotes = (c1.round === "second") ? c1.support_r2[c2] : c1.support[c2];
        c1.comp[c2] = (c1.winner === c2) ? 0 : finalVotes;
        c1.comp[c2] = (Q.nattreshhold[c2]) ? c1.comp[c2] : 0; 
    }
}

// Hagenbach-Bischoff Quotas
for (var d1 of Q.Region) {
    d1.total = 0;
    for (var d2 of Q.parties) {
        d1.total += d1.support[d2];
    }
    d1.cutoff = d1.allvoters / (d1.mandates + 1);
}

// Regional Mandates Distribution
for (var f1 of Q.Region) {
    f1.gain = {};
    f1.comp = {};
    f1.kioszt = 0;
    f1.maradek = {};
    
    for (var f2 of Q.parties) {
        f1.gain[f2] = (Q.nattreshhold[f2]) ? Math.floor(f1.support[f2] / f1.cutoff) : 0;
        Q.reggain[f2] += f1.gain[f2];
        f1.kioszt += f1.gain[f2];
        f1.comp[f2] = (Q.nattreshhold[f2]) ? f1.support[f2] - f1.gain[f2] * f1.cutoff : 0;
    }

    var seatsAvailable = f1.mandates - f1.kioszt; // Fixed snapshot check

    if (seatsAvailable > 0){
        for (var f3 of Q.parties){
            var more = 0;
            for (var f4 of Q.parties){
                if (f1.comp[f4] > f1.comp[f3]) more++;
            }
            if (more < seatsAvailable && f1.comp[f3] >= 2*f1.cutoff/3){
                f1.gain[f3] += 1;
                Q.reggain[f3] += 1;
                f1.maradek[f3] = true;
                f1.kioszt += 1;
            }
        }
    }
    for (var f5 of Q.parties){
        f1.comp[f5] = f1.maradek[f5] ? 0 : f1.comp[f5];
    }
}

// Total National Compensatory Pool
Q.comp = {};
for (var c1 of Q.parties) {
    Q.comp[c1] = 0;
    for (var c2 of Q.oevk) {
        Q.comp[c1] += c2.comp[c1];
    }
    for (var c3 of Q.Region) {
        Q.comp[c1] += c3.comp[c1];
    }
}

// Calculate Remaining National Seat Pool
Q.Natmand = 210;
for (var c1 of Q.Region) {
    for (var c2 of Q.parties) {
        Q.Natmand -= c1.gain[c2];
    }
}

// D'Hondt Formula National Distribution
Q.natgain = {};
for (var p1 of Q.parties) Q.natgain[p1] = 0;

for (var i = 0; i < Q.Natmand; i++) {
    var bestParty = null;
    var bestQuotient = -1;
    for (var p2 of Q.parties) {
        if (!Q.nattreshhold[p2]) continue; // Fixed: Skip ineligible parties
        
        var quotient = Q.comp[p2] / (Q.natgain[p2] + 1);
        if (quotient > bestQuotient) {
            bestQuotient = quotient;
            bestParty = p2;
        }
    }
    if (bestParty) Q.natgain[bestParty] += 1;
}

// Total Seats Summary
Q.seats = {};
for (var p of Q.parties) {
    Q.seats[p] = Q.oevkgain[p] + Q.reggain[p] + Q.natgain[p];
}

// Parliament Proportions
for (var p of Q.parties) {
    Q[p + "_r"] = Math.round((Q.seats[p] / 3.86)*100)/100;
}
!}
go-to: jumpScene